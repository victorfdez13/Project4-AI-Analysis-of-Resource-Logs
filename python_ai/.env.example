APP_NAME=python-ai-lab
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8010

# LLM backend: "template" uses rule-based fallback; "remote" calls the LLM below
EXPLANATION_BACKEND=remote

# Ollama — free local LLM (no API key needed)
# Install: https://ollama.com  then run: ollama run llama3.2
# Use host.docker.internal when running inside Docker; localhost when running directly
REMOTE_LLM_BASE_URL=http://host.docker.internal:11434/v1
REMOTE_LLM_MODEL=llama3.2
REMOTE_LLM_API_KEY=
REMOTE_LLM_TIMEOUT_SECONDS=10

MONGO_URI=mongodb://admin:mongodb123@localhost:27017
MONGO_DATABASE_NAME=resource_logs
MONGO_DATASET1_COLLECTION=dataset1_logs
MONGO_DATASET2_COLLECTION=dataset2_logs
CORS_ALLOW_ORIGINS=http://localhost:5173
