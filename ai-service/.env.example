APP_NAME=ai-service
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# LLM (not used yet, kept for compatibility)
LLM_API_KEY=
MODEL_NAME=gpt-4o-mini

# MongoDB connection (must match the database/docker-compose.yml setup)
MONGO_URI=mongodb://admin:mongodb123@localhost:27017

# Input database with the real SpeedAdmin logs
MONGO_DATABASE_NAME=resource_logs
MONGO_DATASET1_COLLECTION=dataset1_logs
MONGO_DATASET2_COLLECTION=dataset2_logs

# Output database where the analysis results are stored
MONGO_SAVEDLOGS_DATABASE_NAME=savedlogs
MONGO_SAVEDLOGS_COLLECTION=saved_logs

# Comma-separated list of origins allowed to call the API in a browser.
# The frontend talks to the ASP.NET backend, which calls this service
# server-to-server, so CORS is disabled by default. Only set this if you
# need to hit the API directly from a browser (e.g. Swagger UI on
# another host, debugging from the Vite dev server, etc).
CORS_ALLOW_ORIGINS=
