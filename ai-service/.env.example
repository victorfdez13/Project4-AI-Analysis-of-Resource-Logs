APP_NAME=ai-service
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# LLM — three-tier fallback: OpenAI → Ollama (free local) → smart mock
# Leave LLM_API_KEY empty to skip OpenAI and use Ollama or the mock instead
LLM_API_KEY=
MODEL_NAME=gpt-4o-mini

# Ollama — free local LLM (no API key needed)
# Install: https://ollama.com  then run: ollama run llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Local SQLite file for chat conversation history (no Docker needed)
SQLITE_DB_PATH=data/chat_history.db

# MongoDB connection (must match the database/docker-compose.yml setup)
MONGO_URI=mongodb://admin:mongodb123@localhost:27017

# Input database with the real SpeedAdmin logs
MONGO_DATABASE_NAME=resource_logs
MONGO_DATASET1_COLLECTION=dataset1_logs
MONGO_DATASET2_COLLECTION=dataset2_logs

# Output database where the analysis results are stored
MONGO_SAVEDLOGS_DATABASE_NAME=savedlogs
MONGO_SAVEDLOGS_COLLECTION=saved_logs
