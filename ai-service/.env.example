APP_NAME=ai-service
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# LLM provider: "ollama" (default) | "generic" (any OpenAI-compatible URL) | "mock" (no network)
LLM_PROVIDER=ollama

# --- Ollama provider (used when LLM_PROVIDER=ollama) ---
# In Docker Compose the ollama container is at http://ollama:11434/v1
# When running ai-service directly (outside Docker) use http://localhost:11434/v1
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.2

# --- Generic OpenAI-compatible provider (used when LLM_PROVIDER=generic) ---
# Uncomment and fill in to use OpenAI, Together.ai, or any compatible endpoint
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# Local SQLite file for chat conversation history (no Docker needed)
SQLITE_DB_PATH=data/chat_history.db

# MongoDB connection (must match the database/docker-compose.yml setup)
MONGO_URI=mongodb://admin:mongodb123@localhost:27017

# Input database with the real SpeedAdmin logs
MONGO_DATABASE_NAME=resource_logs
MONGO_DATASET1_COLLECTION=dataset1_logs
MONGO_DATASET2_COLLECTION=dataset2_logs

# Output database where the analysis results are stored
MONGO_SAVEDLOGS_DATABASE_NAME=savedlogs
MONGO_SAVEDLOGS_COLLECTION=saved_logs

# Comma-separated list of origins allowed to call the API in a browser.
# The frontend talks to the ASP.NET backend, which calls this service
# server-to-server, so CORS is disabled by default. Only set this if you
# need to hit the API directly from a browser (e.g. Swagger UI on
# another host, debugging from the Vite dev server, etc).
CORS_ALLOW_ORIGINS=
